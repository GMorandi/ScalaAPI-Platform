<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ScalaAPI.Platform.Benchmarks</RootNamespace>
    <!-- Orleans uses Roslyn 5 analyzers while BenchmarkDotNet pins its compiler to 4.14. -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Microsoft.Orleans.TestingHost" Version="10.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Grains/Grains.csproj" />
    <ProjectReference Include="../../src/Grains.Interfaces/Grains.Interfaces.csproj" />
  </ItemGroup>

</Project>
