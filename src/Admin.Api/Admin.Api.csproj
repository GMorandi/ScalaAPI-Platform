<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Orleans.Client" Version="10.2.2" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" Version="10.2.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="SqlSugarCore" Version="5.1.4.216" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="Fido2" Version="4.0.1" />
    <PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Security/**/*.cs" LinkBase="Security" />
    <Compile Include="../Data/Audit/**/*.cs" LinkBase="Data/Audit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Grains.Interfaces/Grains.Interfaces.csproj" />
    <ProjectReference Include="../Data/ScalaAPI.Data.csproj" />
    <ProjectReference Include="../Platform.Host/Platform.Host.csproj" />
  </ItemGroup>

  <!-- Platform.Host is a Web SDK project, so its appsettings.json flows
       transitively into this project's publish output and collides with
       our own copy (NETSDK1152). Drop the transitive copy before the
       conflict check keeps only Admin.Api's appsettings.json. -->
  <Target Name="ExcludeTransitiveHostAppSettings"
          BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.json'
                   and $([System.String]::Copy('%(ResolvedFileToPublish.Identity)').Contains('Platform.Host'))" />
    </ItemGroup>
  </Target>

</Project>
